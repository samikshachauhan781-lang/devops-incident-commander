# ─── Public demo API (Render / shared hosting) ───
DEMO_MODE=true
DEMO_DB_PATH=/tmp/incidents_demo.db
DEMO_DB_SEED_PATH=incidents_demo.db
DEMO_DB_REFRESH_ON_START=true

# Comma-separated browser origins allowed to call the API (your Render static site URL).
# Example: https://devops-incident-commander.onrender.com
CORS_ALLOWED_ORIGINS=

# Legacy single-origin alias (used if CORS_ALLOWED_ORIGINS is unset)
# DEMO_FRONTEND_ORIGIN=

# ─── Local full-stack development only (do not use on public Render API) ───
# DEMO_MODE=false
# DB_PATH=incidents.db

# Optional AI provider for non-demo investigation
# AI_PROVIDER=mock
